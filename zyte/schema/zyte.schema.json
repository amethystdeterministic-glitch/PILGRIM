{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zyte",
  "type": "object",
  "required": ["id", "title", "content"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Deterministic Zyte identifier"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
